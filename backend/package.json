{
  "name": "sistema-advocacia-backend",
  "version": "1.0.0",
  "description": "Backend do Sistema de Gestão para Escritórios de Advocacia",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node database/seeds/run.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js tests/unit/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "docxtemplater": "^3.69.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.6.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.14.0",
    "pizzip": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pdfjs-dist": "^3.11.174",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "^0.12.3",
      "uuid": "^11.1.1"
    },
    "node-cron": {
      "uuid": "^11.1.1"
    }
  }
}
